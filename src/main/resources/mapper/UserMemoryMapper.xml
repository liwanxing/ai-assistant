<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.liwx.learning.rag.mapper.UserMemoryMapper">

    <resultMap id="UserMemoryResultMap" type="com.liwx.learning.rag.entity.UserMemory">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="content" column="content"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByUserId" resultMap="UserMemoryResultMap">
        SELECT id, user_id, content, create_time
        FROM user_memory WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <!-- useGeneratedKeys：insert 后把自增 ID 回填到 userMemory.id，这个 ID 同时作为 Milvus document ID -->
    <insert id="insert" parameterType="com.liwx.learning.rag.entity.UserMemory"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_memory (user_id, content) VALUES (#{userId}, #{content})
    </insert>

    <!-- 语义相似时更新已有记忆的内容 -->
    <update id="updateContent">
        UPDATE user_memory SET content = #{content} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM user_memory WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM user_memory WHERE user_id = #{userId}
    </delete>

</mapper>
