<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.liwx.aiassistant.rag.mapper.RagChunkMapper">

    <!-- 批量插入：一次 INSERT 多行，比循环单条插入快得多 -->
    <insert id="batchInsert">
        INSERT INTO rag_document_chunk (document_id, chunk_id, chunk_index, content)
        VALUES
        <foreach collection="chunks" item="chunk" separator=",">
            (#{chunk.documentId}, #{chunk.chunkId}, #{chunk.chunkIndex}, #{chunk.content})
        </foreach>
    </insert>

    <!--
        关键词检索：MATCH ... AGAINST IN BOOLEAN MODE
        ngram 分词器把中文切成二元组（如"请假"→"请假"），建倒排索引
        + 号表示必须包含，提高精确度
    -->
    <select id="searchByKeyword" resultType="map">
        SELECT chunk_id, content
        FROM rag_document_chunk
        WHERE MATCH(content) AGAINST(#{query} IN BOOLEAN MODE)
        LIMIT #{limit}
    </select>

    <delete id="deleteByDocumentId">
        DELETE FROM rag_document_chunk WHERE document_id = #{documentId}
    </delete>

    <!-- 幂等清理：按文档取全部 chunk_id（即 Milvus 主键），重跑前先删旧数据，保证重复消费结果一致 -->
    <select id="selectChunkIdsByDocumentId" resultType="java.lang.String">
        SELECT chunk_id FROM rag_document_chunk WHERE document_id = #{documentId}
    </select>

    <!--
        按位置批量取分段（窗口扩容）：(document_id, chunk_index) 元组 IN 联合定位，
        一次取回所有命中的 chunk 及其相邻段——比逐段查快，也比单字段 IN 过滤精准
    -->
    <select id="selectByPositions" resultType="map">
        SELECT document_id, chunk_index, content
        FROM rag_document_chunk
        WHERE (document_id, chunk_index) IN
        <foreach collection="positions" item="p" open="(" close=")" separator=",">
            (#{p.documentId}, #{p.chunkIndex})
        </foreach>
    </select>

</mapper>
